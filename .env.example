# TalkQuest — AI-generated missions (optional).
#
# Missions work fully offline from the local database. Set these to ALSO let
# Buddy generate fresh missions with Claude. Copy this file to `.env` and fill
# in the values, then enable "AI missions" in the in-app Settings screen.
#
# Expo inlines EXPO_PUBLIC_* vars into the JS bundle at build time.

# PREFERRED: point at your own backend that proxies to Claude and holds the
# API key server-side. The app sends the mission request here; your server
# adds the Anthropic key and forwards to https://api.anthropic.com/v1/messages.
EXPO_PUBLIC_TALKQUEST_AI_ENDPOINT=

# DEV ONLY: call Anthropic directly with a key embedded in the app.
# ⚠️ Never ship this in a real release — a key in an app bundle is extractable.
EXPO_PUBLIC_TALKQUEST_AI_KEY=

# Optional model override (defaults to claude-opus-4-8).
EXPO_PUBLIC_TALKQUEST_AI_MODEL=
